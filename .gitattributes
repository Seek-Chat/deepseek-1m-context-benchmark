# Keep public text artifacts byte-stable across operating systems.
* text=auto eol=lf

# These files are part of the sealed release or frozen hash contract. Preserve
# their exact bytes, including their original line endings.
/release/** -text whitespace=cr-at-eol
/charts/** -text whitespace=cr-at-eol
/tables/** -text whitespace=cr-at-eol
/gutenberg-draft.template.html -text whitespace=cr-at-eol
/template-bindings.required.json -text whitespace=cr-at-eol
/wordpress-metadata.json -text whitespace=cr-at-eol
/benchmark/protocol.json -text whitespace=cr-at-eol
/benchmark/calibration.json -text whitespace=cr-at-eol

# Generated chart images are binary and must never receive line conversion.
*.png binary
