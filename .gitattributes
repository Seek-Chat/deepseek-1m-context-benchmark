# Keep public text artifacts byte-stable across operating systems.
* text=auto eol=lf

# These files are part of the sealed release or frozen hash contract. Preserve
# their exact bytes, including their original line endings.
/release/** -text
/charts/** -text
/tables/** -text
/gutenberg-draft.template.html -text
/template-bindings.required.json -text
/wordpress-metadata.json -text
/benchmark/protocol.json -text
/benchmark/calibration.json -text

# Generated chart images are binary and must never receive line conversion.
*.png binary
